; OneTunnel WFP transparent redirect callout — primitive driver package.
; Windows 10 1903+ / Windows 11 x64.
; This package MUST be catalog-signed before OneTunnel will install it.

[Version]
Signature   = "$Windows NT$"
Class       = WFPCALLOUTS
ClassGuid   = {57465043-616C-6C6F-7574-5F636C617373}
Provider    = %Provider%
CatalogFile = OneTunnelRedirect.cat
DriverVer   = 11/19/2026,0.5.2.0
PnpLockdown = 1

[SourceDisksNames.amd64]
1 = %DiskName%,,,""

[SourceDisksFiles.amd64]
onetunnel-wfp-redirect.sys = 1,,

[DestinationDirs]
OneTunnelRedirect.CopyFiles = 13

[DefaultInstall.NTamd64]
OptionDesc = %Description%
CopyFiles  = OneTunnelRedirect.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,OneTunnelRedirect.Service

[OneTunnelRedirect.CopyFiles]
onetunnel-wfp-redirect.sys

[OneTunnelRedirect.Service]
DisplayName    = %ServiceDisplayName%
Description    = %ServiceDescription%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\onetunnel-wfp-redirect.sys
LoadOrderGroup = NDIS
Dependencies   = BFE

[Strings]
Provider           = "OneTunnel"
Description        = "OneTunnel WFP Transparent Redirect Callout"
ServiceName        = "OneTunnelWfpRedirect"
ServiceDisplayName = "OneTunnel WFP Redirect"
ServiceDescription = "OneTunnel per-application transparent TCP redirect callout"
DiskName           = "OneTunnel WFP Driver Package"
